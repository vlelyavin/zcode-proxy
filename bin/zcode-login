#!/usr/bin/env bash
# Логин в ZCode через нативный device flow рантайма.
#
# Лаунчер zcode-app-cli разрешает browser-login только на macOS (колбэк zcode://
# регистрируется только там), но в самом рантайме есть device flow:
# /oauth/cli/init -> ссылка -> авторизация в браузере на ЛЮБОМ устройстве -> /oauth/cli/poll.
# Скрипт зовёт рантайм напрямую и обходит mac-only проверку.
set -euo pipefail

# рантайму нужен node:sqlite (node >= 22.5)
need_node() {
  [ -n "$1" ] && [ -x "$1" ] || return 1
  local v major minor
  v="$("$1" -p 'process.versions.node' 2>/dev/null || true)"
  [ -n "$v" ] || return 1
  major="${v%%.*}"
  minor="$(printf '%s' "$v" | cut -d. -f2)"
  [ "$major" -gt 22 ] || { [ "$major" -eq 22 ] && [ "$minor" -ge 5 ]; }
}

NODE=""
for cand in \
  "${ZCODE_NODE:-}" \
  "$HOME/.local/node22/bin/node" \
  "$(command -v node || true)" \
  "$HOME/.local/share/mise/installs/node/$(ls "$HOME/.local/share/mise/installs/node" 2>/dev/null | sort -V | tail -1)/bin/node" \
  "$HOME/.nvm/versions/node/$(ls "$HOME/.nvm/versions/node" 2>/dev/null | sort -V | tail -1)/bin/node"; do
  if need_node "$cand"; then NODE="$cand"; break; fi
done
[ -n "$NODE" ] || { echo "need node >= 22.5 (runtime requires node:sqlite); set ZCODE_NODE=/path/to/node" >&2; exit 1; }

RUNTIME="${ZCODE_RUNTIME:-$HOME/.local/lib/node_modules/zcode-app-cli/vendor/zcode.cjs}"
if [ ! -f "$RUNTIME" ]; then
  for cand in \
    "$(npm root -g 2>/dev/null)/zcode-app-cli/vendor/zcode.cjs" \
    "$HOME/.npm-global/lib/node_modules/zcode-app-cli/vendor/zcode.cjs" \
    "/usr/local/lib/node_modules/zcode-app-cli/vendor/zcode.cjs" \
    "/usr/lib/node_modules/zcode-app-cli/vendor/zcode.cjs"; do
    [ -f "$cand" ] && RUNTIME="$cand" && break
  done
fi
[ -f "$RUNTIME" ] || { echo "runtime not found: npm i -g zcode-app-cli" >&2; exit 1; }

echo "Open the link below on any device where you are logged into chat.z.ai."
echo "The flow lives ~12 minutes, polling is automatic."
echo

exec "$NODE" "$RUNTIME" login --no-browser
